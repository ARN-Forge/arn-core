+// ARN patch: cancellation support for client socket waits.
+inline bool is_interrupted(const std::atomic<bool> *interrupt) {
+  return interrupt && interrupt->load(std::memory_order_acquire);
+}
+
+// Runs `wait(sec, usec)` (a select/poll style wait returning > 0 when ready,
+// 0 on timeout and < 0 on error) and returns -1 once `interrupt` is set.
+// The token is checked before waiting, so a cancellation that arrived
+// between two waits is never lost.
+// The wait runs in short slices up to the same total timeout, so the token
+// alone ends it on every platform. On Windows, shutdown() from another thread
+// wakes neither a blocked select()/WSAPoll() nor a blocking recv(), so
+// ClientImpl::stop() can never be relied on there.
+template <typename Wait>
+inline ssize_t wait_interruptible(time_t sec, time_t usec,
+                                  const std::atomic<bool> *interrupt,
+                                  Wait wait) {
+  if (!interrupt) { return static_cast<ssize_t>(wait(sec, usec)); }
+  if (is_interrupted(interrupt)) { return -1; }
+  using namespace std::chrono;
+  const auto deadline = steady_clock::now() + seconds(sec) + microseconds(usec);
+  const auto interval =
+      microseconds(CPPHTTPLIB_INTERRUPT_CHECK_INTERVAL_USECOND);
+  for (;;) {
+    auto left = duration_cast<microseconds>(deadline - steady_clock::now());
+    if (left.count() < 0) { left = microseconds(0); }
+    const auto slice = (std::min)(left, interval);
+    const auto res = static_cast<ssize_t>(
+        wait(static_cast<time_t>(slice.count() / 1000000),
+             static_cast<time_t>(slice.count() % 1000000)));
+    if (is_interrupted(interrupt)) { return -1; }
+    if (res != 0) { return res; }
+    if (steady_clock::now() >= deadline) { return 0; }
+  }
+}
+
+// ARN patch: true when the last socket call failed only because a
+// non-blocking socket was not ready.
+inline bool is_would_block() {
+#ifdef _WIN32
+  return WSAGetLastError() == WSAEWOULDBLOCK;
+#else
+  return errno == EAGAIN || errno == EWOULDBLOCK;
+#endif
+}
+
+// ARN patch: getaddrinfo() cannot be interrupted. With a token, `resolve`
+// (getaddrinfo or a test double) runs on a helper thread while this thread
+// waits in short slices. On cancellation the lookup is abandoned: the helper
+// thread owns only the shared Lookup state and frees its own result. Without a
+// token, or if no thread can be started, it is a plain call as before.
+template <typename Resolve>
+inline int getaddrinfo_interruptible(Resolve resolve, const char *node,
+                                     const char *service,
+                                     const struct addrinfo *hints,
+                                     struct addrinfo **res,
+                                     const std::atomic<bool> *interrupt) {
+  if (!interrupt) { return resolve(node, service, hints, res); }
+  if (is_interrupted(interrupt)) { return EAI_AGAIN; }
+
+  struct Lookup {
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool done = false;
+    bool abandoned = false;
+    int rc = EAI_FAIL;
+    struct addrinfo *result = nullptr;
+    bool has_node = false;
+    std::string node;
+    std::string service;
+    struct addrinfo hints;
+  };
+  auto lookup = std::make_shared<Lookup>();
+  lookup->has_node = node != nullptr;
+  if (node) { lookup->node = node; }
+  if (service) { lookup->service = service; }
+  memset(&lookup->hints, 0, sizeof(lookup->hints));
+  if (hints) { lookup->hints = *hints; }
+
+  try {
+    std::thread([lookup, resolve]() {
+      struct addrinfo *result = nullptr;
+      const auto rc =
+          resolve(lookup->has_node ? lookup->node.c_str() : nullptr,
+                  lookup->service.c_str(), &lookup->hints, &result);
+      std::lock_guard<std::mutex> guard(lookup->mutex);
+      if (lookup->abandoned) {
+        if (rc == 0 && result) { freeaddrinfo(result); }
+        return;
+      }
+      lookup->rc = rc;
+      lookup->result = rc == 0 ? result : nullptr;
+      lookup->done = true;
+      lookup->cv.notify_all();
+    }).detach();
+  } catch (const std::system_error &) {
+    return resolve(node, service, hints, res);
+  }
+
+  std::unique_lock<std::mutex> lock(lookup->mutex);
+  while (!lookup->done) {
+    if (is_interrupted(interrupt)) {
+      lookup->abandoned = true;
+      return EAI_AGAIN;
+    }
+    lookup->cv.wait_for(
+        lock,
+        std::chrono::microseconds(CPPHTTPLIB_INTERRUPT_CHECK_INTERVAL_USECOND));
+  }
+  *res = lookup->result;
+  return lookup->rc;
+}
+
+inline int getaddrinfo_interruptible(const char *node, const char *service,
+                                     const struct addrinfo *hints,
+                                     struct addrinfo **res,
+                                     const std::atomic<bool> *interrupt) {
+  return getaddrinfo_interruptible(
+      [](const char *n, const char *s, const struct addrinfo *h,
+         struct addrinfo **r) { return getaddrinfo(n, s, h, r); },
+      node, service, hints, res, interrupt);
+}
