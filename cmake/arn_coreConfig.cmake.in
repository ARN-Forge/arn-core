@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include(FetchContent)

if(POLICY CMP0169)
    cmake_policy(SET CMP0169 OLD)
endif()

find_dependency(Threads)

if(NOT TARGET nlohmann_json::nlohmann_json AND NOT TARGET nlohmann_json)
    find_package(nlohmann_json 3.11.3 QUIET)
    if(NOT nlohmann_json_FOUND AND NOT TARGET nlohmann_json::nlohmann_json)
        FetchContent_Declare(
            nlohmann_json
            GIT_REPOSITORY https://github.com/nlohmann/json.git
            GIT_TAG v3.11.3
            GIT_SHALLOW TRUE
        )
        FetchContent_GetProperties(nlohmann_json)
        if(NOT nlohmann_json_POPULATED)
            FetchContent_Populate(nlohmann_json)
        endif()
        add_library(nlohmann_json INTERFACE IMPORTED GLOBAL)
        target_include_directories(nlohmann_json INTERFACE
            "${nlohmann_json_SOURCE_DIR}/include"
        )
        add_library(nlohmann_json::nlohmann_json ALIAS nlohmann_json)
    endif()
endif()

if(TARGET nlohmann_json::nlohmann_json AND NOT TARGET nlohmann_json)
    add_library(nlohmann_json INTERFACE IMPORTED)
    target_link_libraries(nlohmann_json INTERFACE nlohmann_json::nlohmann_json)
elseif(TARGET nlohmann_json AND NOT TARGET nlohmann_json::nlohmann_json)
    add_library(nlohmann_json::nlohmann_json INTERFACE IMPORTED)
    target_link_libraries(nlohmann_json::nlohmann_json INTERFACE nlohmann_json)
endif()

if(NOT TARGET httplib::httplib AND NOT TARGET httplib)
    find_package(httplib 0.18.3 QUIET)
    if(NOT httplib_FOUND AND NOT TARGET httplib::httplib)
        find_package(OpenSSL REQUIRED)
        FetchContent_Declare(
            cpp_httplib
            GIT_REPOSITORY https://github.com/yhirose/cpp-httplib.git
            GIT_TAG v0.18.3
            GIT_SHALLOW TRUE
        )
        FetchContent_GetProperties(cpp_httplib)
        if(NOT cpp_httplib_POPULATED)
            FetchContent_Populate(cpp_httplib)
        endif()
        add_library(httplib INTERFACE IMPORTED GLOBAL)
        target_include_directories(httplib INTERFACE
            "${cpp_httplib_SOURCE_DIR}"
        )
        target_compile_definitions(httplib INTERFACE
            CPPHTTPLIB_OPENSSL_SUPPORT
        )
        target_link_libraries(httplib INTERFACE
            Threads::Threads
            OpenSSL::SSL
            OpenSSL::Crypto
            $<$<PLATFORM_ID:Windows>:ws2_32>
            $<$<PLATFORM_ID:Windows>:crypt32>
        )
        add_library(httplib::httplib ALIAS httplib)
    endif()
endif()

if(TARGET httplib::httplib AND NOT TARGET httplib)
    add_library(httplib INTERFACE IMPORTED)
    target_link_libraries(httplib INTERFACE httplib::httplib)
elseif(TARGET httplib AND NOT TARGET httplib::httplib)
    add_library(httplib::httplib INTERFACE IMPORTED)
    target_link_libraries(httplib::httplib INTERFACE httplib)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/arn_coreTargets.cmake")

if(TARGET arn::core AND NOT TARGET arn::arn_core)
    add_library(arn::arn_core INTERFACE IMPORTED)
    target_link_libraries(arn::arn_core INTERFACE arn::core)
elseif(TARGET arn::arn_core AND NOT TARGET arn::core)
    add_library(arn::core INTERFACE IMPORTED)
    target_link_libraries(arn::core INTERFACE arn::arn_core)
endif()
